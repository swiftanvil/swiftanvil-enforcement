{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swiftanvil/swiftanvil-enforcement/schemas/review-result.schema.json",
  "title": "SwiftAnvil Review Result Metadata",
  "type": "object",
  "required": ["schema_version", "status", "agent", "request", "output"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["success", "failure"] },
    "agent": { "type": "string", "minLength": 1 },
    "builder": { "type": "string" },
    "request": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["APPROVED", "APPROVED_WITH_NOTES", "NEEDS_REVISION", "UNKNOWN"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "exit_code": { "type": "integer" }
  }
}
